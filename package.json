{
  "name": "workdesk",
  "version": "0.0.1",
  "description": "A macOS app that gives every piece of work its own WorkDesk",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "perf": "electron-vite build && node scripts/perf-measure.mjs --desks 1,5,15 --budget scripts/perf-budget.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "electron-rebuild -f -w node-pty",
    "package": "electron-vite build && electron-builder --mac dmg",
    "package:dir": "electron-vite build && electron-builder --mac dir",
    "icons": "bash scripts/make-icons.sh",
    "docs:dev": "pnpm --dir website start",
    "docs:build": "pnpm --dir website build"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.2",
    "@shikijs/monaco": "^4.5.0",
    "@shikijs/vscode-textmate": "^10.1.0",
    "@xterm/addon-webgl": "^0.19.0",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.5.438",
    "shiki": "^4.5.0"
  },
  "packageManager": "pnpm@11.7.0"
}
